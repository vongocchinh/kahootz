{
  "name": "kahootz-theme",
  "version": "1.0.0",
  "description": "Tailwind CSS integration for Kahootz theme",
  "main": "index.js",
  "scripts": {
    "build": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind-output.css",
    "watch": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind-output.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  }
}
